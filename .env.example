# ================================
# Backend Environment Variables
# ================================
# Copy this file to .env and fill in your values

# Groq API Key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# GitHub Fine-Grained PAT (Pull requests: Read & Write, Contents: Read-only)
GITHUB_TOKEN=your_github_pat_here

# Database URL
# Local development (SQLite - default if not set):
#   DATABASE_URL=sqlite:///./rag_audit.db
# Production (Neon PostgreSQL):
#   DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./rag_audit.db

# CORS Origins (comma-separated, set to your Vercel frontend URL in production)
# CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=*

# ChromaDB telemetry
CHROMA_TELEMETRY=false
